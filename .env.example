# ─── Genetic Ayur API ─────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas (or local). Database name goes before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/genetic-ayur?retryWrites=true&w=majority

# At least 32 random characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs every dashboard user out.
JWT_SECRET=
JWT_EXPIRE=1d

# Storefront origins allowed to call the API from the browser, comma separated.
# http://localhost:3000 is always allowed outside production.
CLIENT_URL=https://genetic-ayur.vercel.app

# Reverse proxy hops in front of Node. nginx on the VPS = 1 (the default in
# production). Wrong values break rate limiting.
# TRUST_PROXY=1

# debug = log redacted request details. Leave unset in production.
# LOG_LEVEL=debug

# ─── Public URLs (Phase 2) ────────────────────────────────────────
# Storefront base for the order page after a gateway payment
# (<STOREFRONT_URL>/order/<orderNumber>?payment=success|failed|cancelled|review).
# Defaults to the first CLIENT_URL.
STOREFRONT_URL=https://genetic-ayur.vercel.app
# Public https URL of THIS API. bKash and SSLCommerz call it back and uploaded
# image URLs are built from it, so in production it must be https (the API
# refuses to start otherwise). Local: http://localhost:5000.
API_PUBLIC_URL=http://localhost:5000

# "confirmed" (default): stock is checked at order time but deducted when the
# shop confirms the order in the dashboard. "placed": deducted immediately.
STOCK_DEDUCT_ON=confirmed

# ─── Storefront revalidation + uploads (Phase 3) ──────────────────
# After a dashboard save the API calls the storefront so Vercel drops its
# cached page at once. Local: http://localhost:3000/api/revalidate. Live:
# https://<storefront domain>/api/revalidate. Same secret goes into the
# storefront's env (REVALIDATE_SECRET). Empty = no instant refresh (the
# storefront still refreshes on its own within 5 minutes).
REVALIDATE_URL=
# At least 24 characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=
# Folder for uploaded images on the VPS (served at /uploads). Back it up.
UPLOAD_DIR=uploads

# ─── Gmail SMTP: new order and payment alerts to the shop ─────────
# Empty SMTP_PASS = alerts are skipped (orders still work).
# Gmail needs 2 step verification ON and an App Password (16 letters),
# not the normal Gmail password: myaccount.google.com > Security > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=geneticayur@gmail.com
SMTP_PASS=
MAIL_FROM="Genetic Ayur <geneticayur@gmail.com>"
# Where new order alerts go (comma separated).
ORDER_NOTIFY_TO=geneticayur@gmail.com

# ─── bKash Tokenized Checkout (optional) ──────────────────────────
# From bKash merchant onboarding (PGW). All four empty = bKash works in manual
# mode (Send Money + TrxID, number set in the dashboard). With keys, set
# bKash to "gateway" mode in the dashboard to send shoppers to bKash.
# Sandbox URL below; bKash gives the live URL with the live keys.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# ─── SSLCommerz (optional): cards, bKash, Nagad, Rocket, net banking ─
# Empty = "Online" payment is hidden. Sandbox store: developer.sslcommerz.com
# Set SSLCZ_SANDBOX=false with the live store id and password.
# SSLCZ_STORE_ID=
# SSLCZ_STORE_PASSWORD=
# SSLCZ_SANDBOX=true

# ─── First dashboard account (npm run admin:create) ───────────────
# Or pass them as arguments. Delete ADMIN_PASSWORD after creating the account.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# ─── Tests only ───────────────────────────────────────────────────
# A THROWAWAY database for npm test (it is wiped). Unset = in-memory MongoDB.
# MONGODB_TEST_URI=
